{
  "name": "fanout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A 2D simulation game about multi-agent orchestration: run a company of AI agents and learn why delegation is never free",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "calibrate": "tsx scripts/calibrate.ts"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
